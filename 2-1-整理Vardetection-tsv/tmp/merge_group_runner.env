OUTPUT_DIR=/mnt/f/Onedrive/文档（科研）/脚本/Download/15-NUMTs-detector-V2/2-1-整理Vardetection-tsv/output
FORCE=1
LISTS_DIR=/mnt/f/Onedrive/文档（科研）/脚本/Download/15-NUMTs-detector-V2/2-1-整理Vardetection-tsv/tmp/merge_filelists
MERGE_GROUPS_FILE=/tmp/tmp.GaqKlDpOm2
MERGE_HELPER=/mnt/f/Onedrive/文档（科研）/脚本/Download/15-NUMTs-detector-V2/2-1-整理Vardetection-tsv/script/merge_tsv_group.sh
merge_one_group () 
{ 
    local suffix_key="$1";
    local files_list="$2";
    local output_name="$3";
    local final_output="$OUTPUT_DIR/$output_name";
    bash "$MERGE_HELPER" --suffix-key "$suffix_key" --files-list "$files_list" --output-path "$final_output" --force "$FORCE" --source-mode "none"
}
